rules_version = '2';

// FSC Exam Platform — Firebase Storage rules.
//
// File layout (see apps/web/src/lib/storage.ts):
//   materials/{scope}/{materialId}/{filename}
//     - scope = campusId | "personal-{uid}"
//
// We rely on the role/campus stored in /users/{uid} (Firestore) for
// authorization. Storage rules can read other Firestore docs via
// `firestore.get(...)`.
//
// Read access:
//   - Any signed-in user can fetch a downloadUrl. The list of which
//     materialId a user is allowed to see is gated at the Firestore
//     /learning_materials collection (rules + UI filter by status +
//     campus). Storage being permissively-read keeps the UX simple
//     (no per-object signed URLs) at the cost of: if someone leaks a
//     downloadUrl, anyone with it can fetch the file. For a school
//     pilot this is acceptable; harden in Phase F via short-lived
//     signed URLs from a Cloud Function.
//
// Write access:
//   - Only teacher / TBM / admin can upload. Path enforces the
//     uploader's own uid in the "personal" scope so a teacher can't
//     overwrite another teacher's file.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function callerData() {
      return firestore.get(/databases/(default)/documents/users/$(uid())).data;
    }
    function callerRole() {
      return callerData().role;
    }
    function isTeacherOrAbove() {
      return isSignedIn() && (
        callerRole() == "teacher" ||
        callerRole() == "subject-lead" ||
        callerRole() == "campus-admin" ||
        callerRole() == "academic-director" ||
        callerRole() == "superadmin"
      );
    }

    // ───── /materials — learning materials (videos / pdfs / docs) ─────
    match /materials/{scope}/{materialId}/{file=**} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAbove() &&
        // Per-file size cap — keeps cost bounded on the free tier.
        // 100 MB is enough for typical lecture PDFs and short videos.
        request.resource.size < 100 * 1024 * 1024;
      // No public delete — Firestore archive flow + the
      // deleteStoredFile() helper run from authenticated client code
      // path. The bytes themselves can stay forever (cheap), so we
      // don't strictly need to delete them.
      allow delete: if isTeacherOrAbove();
    }

    // ───── /question-media — audio bài nghe gắn vào câu hỏi ──────────
    //
    // Vì sao audio KHÔNG nhét base64 vào nội dung câu hỏi như ảnh: tài liệu
    // Firestore chỉ chứa được 1MB, mà một bài nghe 5 phút đã là 5MB. Nhét
    // vào là câu hỏi không lưu được.
    //
    // Đọc: mọi người đã đăng nhập — học sinh phải tải được file khi làm bài,
    // và ở thời điểm đó chưa có cách biết em thuộc ca thi nào từ Storage.
    // Cùng đánh đổi với /materials: ai có đường dẫn thì tải được.
    match /question-media/{ownerUid}/{file=**} {
      allow read: if isSignedIn();

      // KHÔNG gọi isTeacherOrAbove() ở đây, dù nó có sẵn ngay bên trên.
      //
      // Hàm đó đọc /users qua `firestore.get(...)` — tức là rules của Storage
      // gọi sang Firestore. Đó là "cross-service rules", và nó chỉ chạy khi
      // service agent của Storage được cấp quyền đọc Firestore. Với dự án vừa
      // BẬT Storage (fsc-khao-thi bật hôm nay) quyền đó có thể chưa có, và khi
      // gọi hỏng thì rules TỪ CHỐI — trả 403 y hệt như bị chặn vì phân quyền.
      // Đã mất ba vòng đi tìm mới ra, vì thông báo lỗi giống hệt nhau.
      //
      // Bỏ nó đi thì mất gì: học sinh cũng ghi được vào THƯ MỤC RIÊNG của
      // chính mình. Không mất gì đáng kể — không màn nào cho học sinh tải
      // file, thư mục của người này người kia không đụng được, và dung lượng
      // vẫn chặn 20MB. Đổi lại, đường tải file không còn phụ thuộc vào một
      // dịch vụ thứ hai.
      allow write: if isSignedIn() &&
        ownerUid == uid() &&
        request.resource.size < 20 * 1024 * 1024;
      allow delete: if isSignedIn() && ownerUid == uid();
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
