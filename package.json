{
  "name": "fsc-exam-platform",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:api": "npm run dev --workspace @fsc/api",
    "dev:worker": "npm run dev --workspace @fsc/worker",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "emu:start": "export PATH=\"/Users/vietnb/.nvm/versions/node/v20.20.2/bin:$PATH\"; firebase emulators:start --only auth,firestore,storage --project demo-fsc",
    "emu:seed": "node scripts/seed-emulator.mjs",
    "emu": "export PATH=\"/Users/vietnb/.nvm/versions/node/v20.20.2/bin:$PATH\"; firebase emulators:exec --only auth,firestore,storage --project demo-fsc \"node scripts/seed-emulator.mjs && echo 'Emulator sẵn sàng. Mở terminal khác chạy: cd apps/web && npm run dev' && tail -f /dev/null\""
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^6.8.2",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "dotenv": "^17.4.2"
  }
}
